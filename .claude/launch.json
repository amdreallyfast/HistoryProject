{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "WebAPI/WebAPI/WebAPI.csproj", "--launch-profile", "WebAPI"],
